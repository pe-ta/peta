# Postgres (Neon / Vercel Postgres). Without it, data lives in memory and is lost on restart.
DATABASE_URL=

# Anthropic API key for copy generation. Without it, copy is rule-based.
ANTHROPIC_API_KEY=

# HMAC secret for client review links. Set a long random string in production.
REVIEW_SECRET=

# Public URL used to build copyable review links (e.g. https://popup-studio.vercel.app)
NEXT_PUBLIC_APP_URL=
