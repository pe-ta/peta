# Postgres (Neon / Vercel Postgres). Without it, data lives in memory and is lost on restart.
DATABASE_URL=

# Generative AI for copy generation and the blunt critique (vision). Set ONE of these.
# Use the same key as the short-video analyzer so both products share a provider.
# Priority when several are set: LLM_PROVIDER, else gemini > openai > anthropic.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider / model
LLM_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5-5

# HMAC secret for client review links. Set a long random string in production.
REVIEW_SECRET=

# Public URL used to build copyable review links (e.g. https://popup-studio.vercel.app)
NEXT_PUBLIC_APP_URL=
